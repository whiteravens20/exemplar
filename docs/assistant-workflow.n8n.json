          "name": "Ollama account"
        }
      },
      "notes": "Chat model. Must support tool calling, since General uses web_search and wikipedia."
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.userId }}",
        "contextWindowLength": 20
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
