      "id": "c455af42-1097-4d1e-b13e-161d080d629b",
      "name": "Postgres Chat Memory",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CRED_ID",
          "name": "Exemplar bot database"
        }
      },
      "notes": "Point this at the bot's own database (DB_* in .env). The bot's /flushmemory and /flushdb clear n8n_chat_histories there."
    },
    {
      "parameters": {
        "toolDescription": "Search the web (SearXNG). Use for current events, prices, releases, or anything that may have changed recently. Input: a short search query. Returns the top results with title, url and snippet.",
        "url": "https://searxng.example.com/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $fromAI('query', 'Short web search query, in the language most likely to find good results', 'string') }}"
            },
            {
              "name": "format",
              "value": "json"
            }
          ]
        },
        "options": {
          "timeout": 20000
        },
        "optimizeResponse": true,
        "responseType": "json",
        "dataField": "results",
        "fieldsToInclude": "selected",
        "fields": "title,url,content"
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "position": [
        -112,
        272
      ],
      "id": "951b2fb0-5bcd-41e1-9352-022ff4d66f40",
      "name": "web_search",
      "notes": "Your SearXNG instance. It must allow the json format and must not rate-limit n8n: add the IP n8n connects from to pass_ip in limiter.toml, or run it with the limiter off."
    },
