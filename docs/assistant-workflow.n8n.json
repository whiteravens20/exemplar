      "typeVersion": 1,
      "position": [
        -1248,
        -96
      ],
      "webhookId": "exemplar-assistant",
      "notes": "Receives DMs and /code requests from the bot. Header Auth: X-API-Key must match N8N_API_KEY. Production URL goes into N8N_WORKFLOW_URL.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_HEADER_AUTH_CRED_ID",
          "name": "X-API-Key (N8N_API_KEY)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.mode }}",
              "value2": "code"
            }
          ]
        }
      },
      "id": "c9af28f8-c7da-4057-a933-9e6154f0d1d4",
      "name": "Check Mode",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -848,
        -96
      ],
      "notes": "mode === \"code\" (the /code command) goes to the Code agent, everything else to General."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"response\": $json.response } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "2f178c62-a5f2-4cdf-b577-9a25b0f9a195",
