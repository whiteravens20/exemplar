    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message }}",
        "options": {
          "systemMessage": "You are an experienced software engineer. Solve the task in a readable, efficient way.\nWrite clean, well-commented code, explain the key decisions, and follow established best practices.\nReply in the language the user wrote in."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -480,
        -320
      ],
      "id": "3c1d3fcc-ad3e-4339-ba80-6df4f3ea5909",
      "name": "Code",
      "notes": "Coding agent for /code. Shares the Postgres memory with General."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message }}",
        "options": {
          "systemMessage": "You are a helpful assistant on Discord.\nKeep answers short and to the point, and reply in the language the user wrote in.\nUse the web_search tool when the answer may be out of date or needs checking against current information, and summarise what you found before answering.\nUse the wikipedia tool for reliable encyclopedic knowledge: definitions, history, and general facts about people, places, events and concepts.\nSummarise the key points instead of quoting long passages."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -480,
        80
      ],
      "id": "5cdc91a0-8b35-4ee9-b74f-f968c46f7bc5",
      "name": "General",
      "notes": "Chat agent for plain DMs, with web_search and wikipedia tools."
    },
    {
      "parameters": {
        "jsCode": "// Flatten the bot payload. n8n's Webhook node nests the POST body under\n// `body`; fall back to the root for manual test executions.\nconst b = $input.first().json.body ?? $input.first().json;\n\nreturn [\n  {\n    json: {\n      userId: b.userId,\n      userName: b.userName,\n      message: b.message,\n      serverId: b.serverId,\n      mode: b.mode || 'chat',\n      timestamp: b.timestamp,\n      platform: b.platform,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1040,
        -96
      ],
      "id": "2b4da4dc-efd9-45ad-aacd-b4d3d877be39",
      "name": "Extract payload",
      "notes": "Unwrap the webhook body and default mode to chat."
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.output;\n\nreturn [{\n  json: {\n    response: response\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -112
      ],
      "id": "d13dcadc-4e6f-4543-8e64-6571002ba726",
      "name": "ResponseMerger",
      "notes": "Maps the agent's output to { response }."
    },
    {
      "parameters": {
        "model": "ministral-3:8b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
