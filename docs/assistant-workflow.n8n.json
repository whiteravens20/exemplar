      "id": "a78d583f-16b6-450e-99ad-bcd3e8e0c534",
      "name": "Qwen2.5 Coder 7B",
      "credentials": {
        "ollamaApi": {
          "id": "REPLACE_WITH_YOUR_OLLAMA_CRED_ID",
          "name": "Ollama account"
        }
      },
      "notes": "Coding model. Any tool-less chat model works; swap for another provider by wiring its chat-model node into Code."
